{
  "name": "@cormidia/learning-loop",
  "version": "0.1.1",
  "description": "Governed adaptation kernel: evidence, inert candidates, independent review, exact activation, measured outcomes",
  "license": "Apache-2.0",
  "author": {
    "name": "Bikram Gupta",
    "url": "https://github.com/bikramgupta"
  },
  "homepage": "https://github.com/cormidia/cormidia-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cormidia/governed-learning-loop.git",
    "directory": "packages/learning-loop"
  },
  "bugs": {
    "url": "https://github.com/cormidia/governed-learning-loop/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "NOTICE",
    "README.md",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./reference-detectors": "./src/reference-detectors/index.ts",
    "./workflows": "./src/workflows/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "./reference-detectors": {
        "types": "./dist/reference-detectors/index.d.ts",
        "default": "./dist/reference-detectors/index.js"
      },
      "./workflows": {
        "types": "./dist/workflows/index.d.ts",
        "default": "./dist/workflows/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  }
}
